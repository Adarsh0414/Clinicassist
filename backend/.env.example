# --- Server ---
PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# --- Database (PostgreSQL) ---
# Point this at your local Postgres install, e.g.:
DATABASE_URL="postgresql://localhost:5432/clinicassist"
# Or, if your Postgres needs a username/password:
#   DATABASE_URL="postgresql://your_username:your_password@localhost:5432/clinicassist"
# Managed Postgres (Render, Railway, Supabase, RDS, etc.) will give you a full
# connection string in this same format too — just paste it in here.

# --- Auth ---
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# --- LLM (Gemini) ---
# Used for the pre-visit symptom summary and the post-visit patient-friendly
# summary. Get a free API key at https://aistudio.google.com/apikey
# If unset, both features fall back to a safe, clearly-labeled default so
# the app keeps working (see src/services/llmService.ts).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash

# --- Email (Brevo — recommended) ---
# Free transactional email at https://app.brevo.com/settings/keys/api — 300
# emails/day free forever, no credit card. If BREVO_API_KEY is set, every
# email in the app (bookings, reminders, OTP codes, etc.) sends through
# Brevo's API automatically — no other email config needed.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=no-reply@clinicassist.example
BREVO_SENDER_NAME=ClinicAssist

# --- Email (SMTP — fallback if BREVO_API_KEY is not set) ---
# Works with SendGrid, Mailgun, Brevo's own SMTP relay, or any SMTP provider.
# If both this and BREVO_API_KEY are left blank in development, the app
# auto-creates a free Ethereal test inbox and logs a preview link to the
# console instead of sending real mail.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="ClinicAssist <no-reply@clinicassist.example>"

# --- Email verification / password reset ---
OTP_EXPIRY_MINUTES=10

# --- Google Sign-In & Google Calendar (same OAuth Client ID for both) ---
# Create credentials at https://console.cloud.google.com/apis/credentials
# (OAuth client type: Web application).
#   - For "Sign in with Google": add your frontend origin (e.g.
#     http://localhost:5173) as an authorized JavaScript origin.
#   - For Calendar sync: add GOOGLE_REDIRECT_URI below as an authorized
#     redirect URI, and enable the Google Calendar API for the project.
# Leave GOOGLE_CLIENT_ID blank to simply hide the "Sign in with Google"
# button — everything else works fine without it.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/calendar/oauth/callback

# --- Booking behavior ---
SLOT_HOLD_MINUTES=5
